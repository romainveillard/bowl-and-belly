{
  "name": "bowl-and-belly",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted PWA for tracking pets' food intake and weight",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.20"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
